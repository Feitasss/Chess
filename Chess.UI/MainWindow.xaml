<Window x:Class="Chess.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chess" Height="600" Width="600"
        Background="#3C3C6C">

    <DockPanel>
        <Border DockPanel.Dock="Left" Width="160" Background="#2E2E3E" Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                    Content="NEW GAME" 
                    Click="NewGameButton_Click"
                    Height="40"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,0,0,10"
                    Background="#4CAF50" Foreground="White"/>

                <CheckBox Name="FlipBoardCheck" 
                          Grid.Row="1"
                          Content="Flip Board View"
                          Foreground="White"
                          FontSize="14"
                          Margin="0,0,0,20"
                          HorizontalAlignment="Center"
                          Checked="FlipBoard_Toggled"
                          Unchecked="FlipBoard_Toggled"/> 

                <TextBlock Grid.Row="2" 
                       Text="Match History" 
                       Foreground="LightGray" 
                       TextAlignment="Center"
                       FontSize="14" 
                       Margin="0,0,0,5"/>

                <ListBox Name="HistoryList" 
                         Grid.Row="3"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="HistoryList_SelectionChanged">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="1" 
                                        BorderBrush="#999" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Winner, StringFormat='Winner: {0}'}" 
                                        Foreground="White" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Reason}" Foreground="#AAA" FontSize="10"/>
                                        <TextBlock Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" 
                                        Foreground="#888" FontSize="10"/>
                                    </StackPanel>
                                </Border>

                                <Button Grid.Column="0"
                                        Content="X"
                                        Width="25" Height="25"
                                        Background="Transparent"
                                        Foreground="#FF5555"
                                        BorderThickness="0"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="DeleteGame_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Name="ReplayControls"
            DockPanel.Dock="Bottom" 
            Orientation="Horizontal" 
            HorizontalAlignment="Center" 
            Margin="0,10"
            Visibility="Collapsed">

            <Button Content="&lt;" 
            Click="ReplayPrevMove_Click" 
            FontSize="16"
            Padding="15,5" 
            Margin="10,0"/>

            <TextBlock Name="GameInfoText" 
               Text="Replay Mode" 
               Foreground="White"
               VerticalAlignment="Center" 
               FontWeight="Bold" 
               FontSize="16"
               Margin="20,0"/>

            <Button Content="&gt;" 
            Click="ReplayNextMove_Click" 
            FontSize="16"
            Padding="15,5" 
            Margin="10,0"/>
        </StackPanel>


        <StackPanel Name="PromotionMenu"
                        Visibility="Collapsed"
                        DockPanel.Dock="Bottom"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#333">
            <TextBlock Text="Choose Promotion" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Queen" Tag="Queen" Click="PromotionButton_Click" Width="80" Height="40" Margin="5"/>
                <Button Content="Rook" Tag="Rook" Click="PromotionButton_Click" Width="80" Height="40" Margin="5"/>
                <Button Content="Bishop" Tag="Bishop" Click="PromotionButton_Click" Width="80" Height="40" Margin="5"/>
                <Button Content="Knight" Tag="Knight" Click="PromotionButton_Click" Width="80" Height="40" Margin="5"/>
            </StackPanel>
        </StackPanel>

        <Viewbox>
            <Grid Height="600" Width="600">

                <UniformGrid Name="BoardGrid" Rows="8" Columns="8" 
                             Background="#D18B47"
                             MouseDown="BoardGrid_MouseDown"/>

                <UniformGrid Name="HighlightGrid" Rows="8" Columns="8" 
                             IsHitTestVisible="False"/>

                <UniformGrid Name="PieceGrid" Rows="8" Columns="8" 
                             IsHitTestVisible="False"/>

                <Grid Name="GameOverMenu" Visibility="Collapsed" Background="#AA000000">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <TextBlock Name="WinnerText" 
                                   Text="White Wins!"
                                   FontSize="48" 
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <TextBlock Name="ReasonText" 
                                   Text="by Checkmate"
                                   FontSize="24" 
                                   Foreground="#DDDDDD"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,40"/>

                        <Button Content="New Game"
                                FontSize="24"
                                Padding="20,10"
                                Cursor="Hand"
                                Click="NewGameButton_Click"/>

                        <Button Name="SaveGameButton"
                                Content="Save to History"
                                FontSize="18"
                                Padding="20,10"
                                Margin="0,0,0,15"
                                Background="#444"
                                Foreground="White"
                                Cursor="Hand"
                                Click="SaveGameButton_Click"/>

                    </StackPanel>
                </Grid>

            </Grid>
        </Viewbox>
        
    </DockPanel>
</Window>